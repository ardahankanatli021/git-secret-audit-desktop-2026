{
  "name": "git-secret-audit-desktop",
  "productName": "Git Secret Audit Desktop",
  "version": "1.0.0",
  "description": "Desktop utility for scanning git repositories for exposed secrets, tokens, and credentials in full commit history.",
  "main": "dist/main/index.js",
  "scripts": {
    "electron:dev": "electron .",
    "electron:build": "electron-builder",
    "start": "electron .",
    "lint": "eslint .",
    "test": "jest --passWithNoTests"
  },
  "keywords": [
    "gitleaks",
    "trufflehog",
    "secret-scanning",
    "git-security",
    "devops"
  ],
  "repository": {
    "type": "git",
    "url": "git+https://github.com/ardahankanatli021/git-secret-audit-desktop-2026.git"
  },
  "author": "ardahankanatli021",
  "license": "MIT",
  "homepage": "https://github.com/ardahankanatli021/git-secret-audit-desktop-2026#readme",
  "build": {
    "appId": "git.secret.audit.desktop",
    "productName": "Git Secret Audit Desktop",
    "copyright": "Copyright 2026 ardahankanatli021",
    "directories": {
      "output": "dist"
    },
    "files": [
      "dist/**/*",
      "package.json",
      "tsconfig.json",
      "README.md",
      "LICENSE.md"
    ],
    "linux": {
      "target": ["AppImage", "deb", "rpm"]
    },
    "win": {
      "target": ["nsis"]
    }
  },
  "dependencies": {
    "electron": "^28.0.0",
    "react": "^18.2.0",
    "react-dom": "^18.2.0",
    "styled-components": "^6.0.0",
    "electron-store": "^^8.1.0"
  },
  "devDependencies": {
    "@types/electron": "^28.0.0",
    "@types/react": "^18.2.0",
    "@types/react-dom": "^18.2.0",
    "@types/styled-components": "^6.0.0",
    "electron-builder": "^24.6.3",
    "jest": "^29.7.0",
    "ts-jest": "^29.1.0",
    "typescript": "^5.3.0"
  }
}